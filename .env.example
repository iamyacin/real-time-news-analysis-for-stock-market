# Copy this file to .env and fill only what you need.
# The demo works with the local MongoDB defaults and no API keys.

# --- MongoDB ---------------------------------------------------------------
# Local Docker fallback (default):
MONGO_URI=mongodb://localhost:27017
# Atlas example (put your own fresh URI here):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Inside Docker Compose, use this variable to point containers at Atlas while
# keeping the local mongo service as a fallback:
# MONGO_URI_DOCKER=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=StockNewsDB
MONGO_COLLECTION=NewsCollection

# --- Prediction service ----------------------------------------------------
SERVICE_URL=http://localhost:5000
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000

# finbert = pretrained financial BERT (downloaded on first use)
# hf      = a local HuggingFace model trained with scripts/train_polarity.py
# legacy  = original ktrain predictor (Python 3.10 legacy profile)
# sklearn = fast offline fallback trained from LabeledNews.csv
POLARITY_BACKEND=finbert
POLARITY_MODEL=ProsusAI/finbert
# POLARITY_MODEL_DIR=PythonObjects/PolarityClassifier
# LEGACY_POLARITY_DIR=PythonObjects/legacy/PolarityClassifier/BertPolarityClassifier

# --- NewsAPI (optional; fixtures are the default demo) ---------------------
# NEWSAPI_KEY=
# NEWSAPI_KEYS=key1,key2

# --- Legacy React/Spring UI ------------------------------------------------
JWT_SECRET=local-demo-secret-change-me
LEGACY_API_PORT=8081
# LEGACY_API_URL=http://localhost:8081
# STREAMLIT_URL=http://localhost:8501
# FRONTEND_URL=http://localhost:3000
